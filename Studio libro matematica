          <p id="diagnosticText" class="text-sm leading-relaxed"></p>
        </div>

        <!-- Confronto Risolutivo: Metodo del Libro vs Hack Desmos College Board -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- Metodo 1: Come lo risolve il Libro -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <div class="flex items-center gap-2 text-indigo-400 font-bold text-sm uppercase tracking-wider mb-3">
              <span>📖</span> <span>Metodo Analitico del Libro</span>
            </div>
            <div id="bookMethodText" class="text-sm text-slate-200 space-y-2 leading-relaxed select-text"></div>
          </div>

          <!-- Metodo 2: Come risolverlo su Desmos (College Board Edition) -->
          <div class="bg-slate-900 border border-emerald-900/60 rounded-xl p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm uppercase tracking-wider">
                <span>⚡</span> <span>Strategia Desmos (Digital SAT)</span>
              </div>
              <span class="text-[11px] bg-emerald-950 text-emerald-300 px-2 py-0.5 rounded border border-emerald-800">Salva-Tempo</span>
            </div>
            <div id="desmosMethodText" class="text-sm text-slate-200 space-y-2 leading-relaxed select-text"></div>
          </div>

        </div>
      </div>

    </main>
