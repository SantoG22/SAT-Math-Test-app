      <button onclick="toggleCheatSheet()" class="bg-amber-600 hover:bg-amber-500 text-white px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center gap-1.5 transition">
        <span>📐</span> CheatSheet
      </button>

      <button onclick="toggleSettings()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 p-2 rounded-lg text-sm border border-slate-700">
        ⚙️
      </button>
    </div>
  </header>

  <!-- MAIN WORKSPACE -->
  <div class="flex-1 flex overflow-hidden">
    
    <!-- SIDEBAR SINISTRA: Caricamento Libro, Albero Argomenti e Scatole di Leitner -->
    <aside class="w-72 md:w-80 bg-slate-900 border-r border-slate-800 flex flex-col shrink-0 overflow-y-auto">
      
      <!-- Sezione 1: Carica Libro PDF -->
      <div class="p-4 border-b border-slate-800">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1. Carica Libro / Capitolo (PDF)</label>
        <input type="file" id="pdfUpload" accept="application/pdf" class="block w-full text-xs text-slate-300
