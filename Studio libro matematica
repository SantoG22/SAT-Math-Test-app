  <link rel="stylesheet" type="text/css" href="https://jsxgraph.org/distrib/jsxgraph.css" />
  <script type="text/javascript" src="https://jsxgraph.org/distrib/jsxgraphcore.js"></script>

  <!-- PDF.js per estrarre testo ed esempi dai tuoi libri in PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <style>
    @keyframes pulse-urgent {
      0%, 100% { background-color: #ef4444; color: white; transform: scale(1); }
      50% { background-color: #7f1d1d; color: #fecaca; transform: scale(1.04); }
    }
    .timer-overtime {
      animation: pulse-urgent 0.9s infinite;
      border-color: #f87171 !important;
    }
    .timer-warning {
      background-color: #f59e0b;
      color: #1e293b;
    }
    /* Ottimizzazione touch per iPad */
    button, input, select { touch-action: manipulation; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
