      <div class="bg-indigo-600 p-2 rounded-lg font-black text-lg tracking-wider">SAT // MATH</div>
      <div>
        <h1 class="font-bold text-sm md:text-base leading-tight">Book Parser & Leitner Trainer</h1>
        <p class="text-xs text-slate-400" id="bookStatus">Modalità Demo Attiva (Carica un PDF o API Key per generare dal libro)</p>
      </div>
    </div>

    <!-- Timer Digital SAT (Target: 95s per domanda) -->
    <div class="flex items-center gap-3">
      <div id="timerBox" class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800 border border-slate-700 font-mono text-lg font-bold transition-all">
        <span>⏱️</span>
        <span id="timerDisplay">00:00</span>
        <span class="text-xs font-normal text-slate-400 hidden sm:inline">/ 01:35 target</span>
      </div>

      <button onclick="toggleDesmosModal()" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center gap-1.5 transition">
        <span>📈</span> <span class="hidden md:inline">Calcolatrice</span> Desmos
