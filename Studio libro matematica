  <!-- MODALE 1: CHEATSHEET PROPRIETÀ E FORMULE GEOMETRICHE -->
  <div id="cheatSheetModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-5xl w-full max-h-[90vh] flex flex-col overflow-hidden shadow-2xl">
      <div class="px-6 py-4 bg-slate-800 flex justify-between items-center border-b border-slate-700">
        <div>
          <h2 class="text-lg font-bold text-amber-400">📐 Digital SAT Math CheatSheet Completo</h2>
          <p class="text-xs text-slate-300">Tutte le formule di riferimento ufficiali + le identità algebriche e geometriche ad alto rendimento</p>
        </div>
        <button onclick="toggleCheatSheet()" class="text-slate-400 hover:text-white text-xl font-bold px-2">✕</button>
      </div>
      
      <div class="p-6 overflow-y-auto grid grid-cols-1 md:grid-cols-2 gap-6 text-sm" id="cheatSheetContent">
        
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-indigo-400 border-b border-slate-800 pb-1">1. Algebra & Sistemi Lineari</h3>
          <p>• <b>Forma Esplicita (Slope-Intercept):</b> $y = mx + b$ dove $m = \frac{y_2 - y_1}{x_2 - x_1}$.</p>
          <p>• <b>Numero di Soluzioni di un Sistema Lineare:</b><br>
             Dato $a_1x + b_1y = c_1$ e $a_2x + b_2y = c_2$:<br>
             - <b>Infinite soluzioni:</b> $\frac{a_1}{a_2} = \frac{b_1}{b_2} = \frac{c_1}{c_2}$ (stessa retta)<br>
             - <b>Nessuna soluzione:</b> $\frac{a_1}{a_2} = \frac{b_1}{b_2} \neq \frac{c_1}{c_2}$ (rette parallele)<br>
             - <b>Una soluzione:</b> $\frac{a_1}{a_2} \neq \frac{b_1}{b_2}$</p>
          <p>• <b>Distanza e Punto Medio:</b> $d = \sqrt{(x_2-x_1)^2 + (y_2-y_1)^2}$, $M = \left(\frac{x_1+x_2}{2}, \frac{y_1+y_2}{2}\right)$.</p>
        </div>

        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-indigo-400 border-b border-slate-800 pb-1">2. Quadratica & Polinomi (Advanced Math)</h3>
          <p>• <b>Forme della Parabola:</b><br>
             - Standard: $y = ax^2 + bx + c$ (Vertice: $x_V = -\frac{b}{2a}$)<br>
             - Vertice: $y = a(x - h)^2 + k$ con vertice in $(h, k)$<br>
             - Fattorizzata: $y = a(x - r_1)(x - r_2)$</p>
          <p>• <b>Somma e Prodotto delle Radici (Viète):</b><br>
             Somma $r_1 + r_2 = -\frac{b}{a}$ &nbsp;|&nbsp; Prodotto $r_1 \cdot r_2 = \frac{c}{a}$.</p>
          <p>• <b>Discriminante ($\Delta = b^2 - 4ac$):</b><br>
             $\Delta > 0$ (2 sol. reali), $\Delta = 0$ (1 sol. reale tangente), $\Delta < 0$ (0 sol. reali).</p>
        </div>

        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-indigo-400 border-b border-slate-800 pb-1">3. Geometria Piana, Cerchi e Triangoli</h3>
          <p>• <b>Equazione del Cerchio:</b> $(x - h)^2 + (y - k)^2 = r^2$ con centro $(h, k)$ e raggio $r$.</p>
          <p>• <b>Arco e Settore Circolare (in radianti):</b><br>
             Lunghezza arco $s = r\theta$ &nbsp;|&nbsp; Area settore $A = \frac{1}{2}r^2\theta$.</p>
          <p>• <b>Triangoli Rettangoli Speciali:</b><br>
             - $45^\circ\text{-}45^\circ\text{-}90^\circ$: lati $x, x, x\sqrt{2}$<br>
             - $30^\circ\text{-}60^\circ\text{-}90^\circ$: lati $x, x\sqrt{3}, 2x$</p>
          <p>• <b>Trigonometria & Angoli Complementari:</b> $\sin(x^\circ) = \cos(90^\circ - x^\circ)$.</p>
        </div>

        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
          <h3 class="font-bold text-indigo-400 border-b border-slate-800 pb-1">4. Volumi, Statistica & Comandi Desmos</h3>
          <p>• <b>Volumi Ufficiali SAT:</b> Cilindro $V = \pi r^2 h$ | Sfera $V = \frac{4}{3}\pi r^3$ | Cono $V = \frac{1}{3}\pi r^2 h$ | Piramide $V = \frac{1}{3}lwh$.</p>
          <p>• <b>Esponenziali & Percentuali:</b> $y = a(1 \pm r)^t$.</p>
          <p>• <b>Comandi Rapidi Desmos SAT:</b><br>
             - <code>y1 ~ m x1 + b</code> (Regressione su tabella punti)<br>
             - <code>mean(1, 4, 7, 10)</code> e <code>median(...)</code><br>
             - <code>stdev(...)</code> per confrontare la dispersione dei dati<br>
             - Digita <code>slider</code> quando hai costanti $k$ o $a$ per testare equivalenze.</p>
        </div>

      </div>
    </div>
  </div>

  <!-- MODALE 2: CALCOLATRICE DESMOS INTEGRATA -->
  <div id="desmosModal" class="hidden fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
      <div class="px-4 py-3 bg-slate-800 flex justify-between items-center border-b border-slate-700">
        <span class="font-bold text-sm text-emerald-400">📈 Desmos Graphing Calculator (Ambiente di Test)</span>
        <button onclick="toggleDesmosModal()" class="text-slate-300 hover:text-white font-bold px-2">✕ Chiudi</button>
      </div>
      <iframe src="https://www.desmos.com/calculator" class="w-full flex-1 bg-white"></iframe>
    </div>
  </div>

  <!-- MODALE 3: IMPOSTAZIONI API GEMINI (Per generare esercizi infiniti dai tuoi PDF) -->
  <div id="settingsModal" class="hidden fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center">
        <h3 class="font-bold text-base">⚙️ Configurazione AI & Timer</h3>
        <button onclick="toggleSettings()" class="text-slate-400 hover:text-white">✕</button>
      </div>
      <div class="space-y-2 text-xs text-slate-300">
        <label class="block font-semibold">Gemini API Key (Opzionale ma consigliata per i PDF):</label>
        <input type="password" id="geminiApiKey" placeholder="AIzaSy..." class="w-full bg-slate-950 border border-slate-700 rounded p-2 text-sm">
        <p class="text-[11px] text-slate-400">
          Inserendo la tua chiave gratuita di Google AI Studio, quando carichi un libro in PDF l'app legge le pagine che scegli, crea in automatico l'albero degli argomenti, genera esercizi identici a quelli del testo e analizza i tuoi errori algebrici in tempo reale. La chiave resta salvata solo nel tuo browser.
        </p>
      </div>
      <div class="space-y-2 text-xs text-slate-300">
        <label class="block font-semibold">Soglia Allarme Timer SAT (secondi):</label>
        <input type="number" id="timerThresholdInput" value="95" class="w-full bg-slate-950 border border-slate-700 rounded p-2 text-sm">
        <p class="text-[11px] text-slate-400">Nel Digital SAT Math hai 35 minuti per 22 domande (~95 secondi a domanda).</p>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="saveSettings()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-xs font-bold">Salva Impostazioni</button>
      </div>
    </div>
  </div>

  <script>
    // Configurazione Worker PDF.js
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    // STATO DELL'APPLICAZIONE E DATABASE DI ESEMPIO PRE-CARICATO
    let satTimeLimit = parseInt(localStorage.getItem('sat_timer_limit') || '95', 10);
    let currentSeconds = 0;
    let timerInterval = null;
    let loadedPdfDoc = null;
    let currentQuestionIndex = 0;
    let activeQuestionsList = [];

    const defaultQuestionsDB = [
      {
        id: "alg_sys_1",
        topic: "1. Algebra",
        subtopic: "1.1 Sistemi Lineari con Parametro (Nessuna Soluzione)",
        source: "Esempio Capitolo 3 - Pag. 42",
        title: "Sistema Lineare Parametrico",
        question: "Nel sistema di equazioni lineari qui sotto, $k$ è una costante. Se il sistema non ha alcuna soluzione (no solution), qual è il valore di $k$? $$\\begin{cases} 3x - 4y = 10 \\\\ kx + 6y = 15 \\end{cases}$$",
        options: [
          { label: "A", text: "$-4.5$" },
          { label: "B", text: "$-2$" },
          { label: "C", text: "$2$" },
          { label: "D", text: "$4.5$" }
        ],
        correctAnswer: "A",
        acceptableValues: ["A", "-4.5", "-9/2"],
        commonMistakes: {
          "D": "Hai dimenticato il segno meno! Nella prima equazione $y$ ha coefficiente $-4$, nella seconda $+6$: il rapporto dei coefficienti deve rispettare i segni.",
