        <div id="pdfExtractControls" class="hidden mt-3 space-y-2">
          <div class="flex items-center gap-2 text-xs">
            <span>Da pag:</span>
            <input type="number" id="pageStart" value="1" min="1" class="w-14 bg-slate-800 border border-slate-700 rounded px-2 py-1 text-center">
            <span>A pag:</span>
            <input type="number" id="pageEnd" value="5" min="1" class="w-14 bg-slate-800 border border-slate-700 rounded px-2 py-1 text-center">
          </div>
          <button onclick="extractAndGenerateFromPDF()" id="btnGeneratePDF" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white py-1.5 rounded-lg text-xs font-bold transition">
            ⚡ Estrai Argomenti e Genera Esercizi
