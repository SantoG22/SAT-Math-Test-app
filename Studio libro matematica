        <div class="flex items-center gap-2">
          <span id="questionSourceBadge" class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded border border-slate-700">Esempio Simile al Libro</span>
          <span id="leitnerStatusBadge" class="text-xs bg-slate-800 text-amber-400 px-2.5 py-1 rounded border border-slate-700">Box 1</span>
